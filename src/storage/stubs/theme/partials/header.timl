header.site-header
  a.site-brand href="/"
    img src=url($this["site"]["logo"]) alt=$this["site"]["title"] height="32"
  if $this["site"]["hasNotifications"] == true:
    div.site-notice: $this["config"]["header"]["notification"]
  if $this["config"]["header"]["search"]["enable"] == true:
    form.spotlight-form action="/search" method="GET"
      input.spotlight type="search" name="q" placeholder="Search the blog..." aria-label="Search the blog"
      button type="submit": "Search"
  if $this["config"]["navbar"] != nil and len($this["config"]["navbar"]) > 0:
    nav.site-nav
      for $navItem in items($this["config"]["navbar"]):
        a href=$navItem["url"]: $navItem["title"]
  if $this["currentLang"] != "":
    if len($this["translations"]) > 1:
      nav.site-nav.language-switcher
        for $tr in items($this["translations"]):
          if $tr["lang"] != $this["currentLang"]:
            a.language-switcher__link href=$tr["url"]: $tr["lang"]
          else:
            span.language-switcher__current: $tr["lang"]
