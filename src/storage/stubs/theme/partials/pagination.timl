if toFloat($this["totalPages"]) > 1:
  nav.pagination aria-label="Blog pagination"
    if $this["prevUrl"] != "":
      a href=url($this["prevUrl"]) aria-label="Previous": "&#8592;"
    span: "Page " & $this["page"] & " of " & $this["totalPages"]
    if $this["nextUrl"] != "":
      a href=url($this["nextUrl"]) aria-label="Next": "&#8594;"
