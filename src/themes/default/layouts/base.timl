html data-bs-theme="dark" data-lang=$this["currentLang"]
  head
    meta charset="utf-8"
    title: $this["config"]["metadata"]["title"] & " &mdash; " & $this["config"]["metadata"]["description"]
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="description" content=$this["config"]["metadata"]["description"]
    link rel="icon" href=url("/cache/favicon-32x32.png") type="image/x-icon"
    link rel="stylesheet" href=url("/cache/bundle.css")
    if $this["config"]["mode"] != "pages":
      if $this["config"]["feed"]["enable"]:
        if $this["config"]["feed"]["kind"] == "atom":
          link rel="alternate" type="application/atom+xml" title="Atom Feed" href=url("/feed.xml")
        else:
          link rel="alternate" type="application/rss+xml" title="RSS Feed" href=url("/feed.xml")
    link rel="alternate" type="text/plain" title="llms.txt" href=url("/llms.txt")
    if $this["currentLang"] != "":
      for $tr in items($this["translations"]):
        link rel="alternate" hreflang=$tr["lang"] href=$this["site"]["baseUrl"] & $tr["url"]

    const bgNoise = toFloat($this["config"]["appearance"]["background_noise_opacity"])
    if $bgNoise > 0:
      style: """
body:before {
  content: "";
  display: block;
  background-image: url(""" & url("/cache/image.png") & """);
  background-repeat: repeat;
  background-size: 257px auto;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 99999;
  opacity: """ & $bgNoise & """;
}
      """

  body
    div.container > div.row > div.col-lg-8.mx-auto
      div.row
        // The `@view` macro is a special macro that injects
        // the content of the specific view into this layout.
        @view
      footer.row.mb-4 > div.col-12.text-center.opacity-75 > small
        if $this["config"]["footer"]["text"] != nil:
          p.mt-4.mb-1: $this["config"]["footer"]["text"]
        if $this["config"]["footer"]["links"] != nil and len($this["config"]["footer"]["links"]) > 0:
          p.mt-2.mb-1
            for $link in items($this["config"]["footer"]["links"]):
              a.me-3.text-decoration-none href=url($link["url"]): $link["title"]
        p.mt-3.mb-0: $this["currentYear"] & " &copy; " & $this["config"]["metadata"]["title"] & " | MIT License"
        p: "Powered by "
          a href="https://github.com/openpeeps/stupidgreen": "StupidGreen"
          " &mdash; Made by Humans from "
          a href="https://openpeeps.dev": "OpenPeeps"

    script type="text/javascript" src=url("/cache/bundle.js")
    @javascript
document.addEventListener('DOMContentLoaded', () => {
  UI.init({
    enableStickySidebar: true,
    enableTimeAgo: true,
    enableAnimatedAlerts: true
  });

  const toggleAreaBtns = document.querySelectorAll('button[data-toggle-area]');
  const mainArea = document.querySelector('div[data-area="main"]');
  const leftSidebar = document.querySelector('div[data-area="left"]');
  const rightSidebar = document.querySelector('div[data-area="right"]');

  // Load preferences from localStorage
  let isLeftSidebarVisible = localStorage.getItem('leftSidebarVisible') !== 'false';
  let isRightSidebarVisible = localStorage.getItem('rightSidebarVisible') !== 'false';

  function updateMainAreaCols() {
    if (!isLeftSidebarVisible && !isRightSidebarVisible) {
      mainArea.classList.remove('col-lg-7', 'col-lg-9');
      mainArea.classList.add('col-lg-12');
    } else if (!isLeftSidebarVisible || !isRightSidebarVisible) {
      mainArea.classList.remove('col-lg-7', 'col-lg-12');
      mainArea.classList.add('col-lg-9');
    } else {
      mainArea.classList.remove('col-lg-9', 'col-lg-12');
      mainArea.classList.add('col-lg-7');
    }
  }

  function updateSidebarVisibility() {
    if (isLeftSidebarVisible) {
      leftSidebar.classList.remove('d-none');
      leftSidebar.classList.add('d-lg-block');
    } else {
      leftSidebar.classList.remove('d-lg-block');
      leftSidebar.classList.add('d-none');
    }
    if (isRightSidebarVisible) {
      rightSidebar.classList.remove('d-none');
      rightSidebar.classList.add('d-lg-block');
    } else {
      rightSidebar.classList.remove('d-lg-block');
      rightSidebar.classList.add('d-none');
    }
  }

  toggleAreaBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const areaName = btn.getAttribute('data-toggle-area');
      const areaElement = document.querySelector(`div[data-area="${areaName}"]`);
      const icon = btn.querySelectorAll('span');
      if (areaElement.classList.contains('d-lg-block')) {
        areaElement.classList.remove('d-lg-block');
        areaElement.classList.add('d-none');
        if (areaName === 'left') {
          isLeftSidebarVisible = false;
          localStorage.setItem('leftSidebarVisible', 'false');
        } else if (areaName === 'right') {
          isRightSidebarVisible = false;
          localStorage.setItem('rightSidebarVisible', 'false');
        }
      } else {
        areaElement.classList.remove('d-none');
        areaElement.classList.add('d-lg-block');
        if (areaName === 'left') {
          isLeftSidebarVisible = true;
          localStorage.setItem('leftSidebarVisible', 'true');
        } else if (areaName === 'right') {
          isRightSidebarVisible = true;
          localStorage.setItem('rightSidebarVisible', 'true');
        }
      }
      updateMainAreaCols();
      // Optionally toggle icons here
      icon[0].classList.toggle('d-none');
      icon[1].classList.toggle('d-none');
    });
  });

  // Initial setup
  updateSidebarVisibility();
  updateMainAreaCols();
});
    @end
    
    if $this["config"]["content"]["lazyloadIframes"] or
       $this["config"]["content"]["lazyloadVideos"] or
       $this["config"]["content"]["lazyloadImages"]:
      @javascript
      {
        UI.onReload(() => {
          const lazyMedia = document.querySelectorAll('iframe[data-src], video[data-src], audio[data-src], source[data-src], img[data-src]');
          const loadMedia = (el) => {
            setTimeout(() => {
              el.src = el.dataset.src;
              el.removeAttribute('data-src');
            }, 150);
          };
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  loadMedia(entry.target);
                  obs.unobserve(entry.target);
                }
              });
            }, { rootMargin: '200px' });
            lazyMedia.forEach(el => observer.observe(el));
          } else {
            lazyMedia.forEach(loadMedia);
          }
        });
      }
      @end

    // Connects to the Watchout server to listen
    // for file changes and reloads the page when a change is detected.
    if $app["isDev"] == true:
      @javascript
      {
        function connectWatchoutServer() {
          const watchout = new WebSocket("ws://127.0.0.1:9000");
          watchout.addEventListener('message', (e) => {
            if(e.data == '1') location.reload()
          });

          watchout.addEventListener('close', () => {
            setTimeout(() => {
              console.log('Watchout WebSocket is closed. Try again...')
              connectWatchoutServer()
            }, 300)
          })
        }
        connectWatchoutServer()
      }
      @end

    // Connects to the StupidGreen Markdown sync WebSocket endpoint
    // (`/ws`) to reload the page whenever content changes. This
    // is enabled when running the server with `--sync`.
    if $this["hasMarkdownSync"] == true:
      @javascript
      {
        function connectMarkdownSync() {
          const sync = new WebSocket(`http://${window.location.host}/ws`);
          sync.addEventListener('message', (e) => {
            if(e.data == '1') location.reload()
          });

          sync.addEventListener('close', () => {
            setTimeout(() => {
              console.log('Markdown sync WebSocket is closed. Retrying...')
              connectMarkdownSync()
            }, 300)
          })
        }
        connectMarkdownSync()
      }
      @end