div.navbar-container-area.sticky-top.user-select-none
  if $this["site"]["hasNotifications"] == true:
    div.text-center.border-bottom.border-dark.p-1.small: $this["config"]["header"]["notification"]
  nav.navbar.navbar-expand-lg.py-2
    div.container.d-flex
      a.navbar-brand.fw-bold.py-0 href=url("/")
        img src=url($this["site"]["logo"]) alt=$this["site"]["title"] height="32"

      if $this["config"]["header"]["search"]["enable"] == true:
        div.col-6.col-lg-4
          form.spotlight-form.d-flex.ms-3.mb-0.position-relative action=url("/search") method="GET"
            input.form-control.form-control-sm.px-3.rounded-4.spotlight.border-2.me-2 type="search" name="q" placeholder=i18n("Search the blog...") aria-label=i18n("Search the blog")
            button.btn.btn-sm.text-muted.position-absolute.me-2.border-0 type="submit" style="margin-top:2px; right:10px;": "⌘/"

      div#navbarSupportedContent.collapse.navbar-collapse
        if $this["config"]["navbar"] != nil and len($this["config"]["navbar"]) > 0:
          ul.navbar-nav.ms-auto.mb-2.mb-lg-0
            for $navItem in items($this["config"]["navbar"]):
              li.nav-item.mx-1
                a.nav-link.fw-medium href=url($navItem["url"]): $navItem["title"]
        if $this["currentLang"] != "":
          if len($this["translations"]) > 1:
            select.language-switcher.form-select.form-select-sm.w-auto.ms-3 aria-label=i18n("Language") onchange="location=this.value"
              for $tr in items($this["translations"]):
                if $tr["lang"] != $this["currentLang"]:
                  option value=$this["site"]["baseUrl"] & $tr["url"]: $tr["lang"]
                else:
                  option value=$this["site"]["baseUrl"] & $tr["url"] selected="selected": $tr["lang"]
