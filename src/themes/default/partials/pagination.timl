if toFloat($this["totalPages"]) > 1:
  nav.mt-5 aria-label="Blog pagination"
    ul.pagination.justify-content-center
      if $this["prevUrl"] != "":
        li.page-item
          a.page-link href=url($this["prevUrl"]) aria-label=i18n("Previous"): "&#8592;"
      li.page-item.disabled > span.page-link: i18n("Page {page} of {total}", {page: $this["page"], total: $this["totalPages"]})
      if $this["nextUrl"] != "":
        li.page-item
          a.page-link href=url($this["nextUrl"]) aria-label=i18n("Next"): "&#8594;"
