@include "header"
div.container-fluid.my-4 style="min-height:calc(100vh - 150px)"
  div.row > div.col-xl-10.col-12.mx-auto
    div.row.mb-4 > div.col-12
      div.d-flex.align-items-center.gap-2.flex-wrap
        h1.h4.fw-bold.my-0: i18n("Tag: {tag}", {tag: $this["tag"]})
        a.badge.text-bg-secondary.text-decoration-none href=url("/tags/" & $this["tagSlug"]): $this["tagSlug"]
      if len($this["posts"]) > 0:
        p.text-muted.mb-0: i18nPlural("{count} post", "{count} posts", len($this["posts"]), {count: len($this["posts"])})

    @include "post-cards"
